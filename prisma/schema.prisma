generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

model ActivitySet {
  id                   String       @id @default(cuid())
  title                String
  activityType         ActivityType
  difficulty            String       @default("medium")
  hint                 String       @default("")
  generatedHtmlSettings String      @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  words                Word[]

  @@index([activityType])
}

model Word {
  id                String      @id @default(cuid())
  activitySetId     String
  phonemeWord       String
  englishEquivalence String
  phonemes          String
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  activitySet       ActivitySet @relation(fields: [activitySetId], references: [id], onDelete: Cascade)

  @@index([activitySetId])
}
